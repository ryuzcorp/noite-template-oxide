{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noite-app",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "workers_dev": true,
  // celld (the Noite runtime) serves every path through the Worker; hashed
  // client assets come from `assets.directory` in the built config.
  // `not_found_handling: "none"` keeps real 404s: a missing `/assets/*.js`
  // must not fall back to index.html.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  }
  // Optional D1 example: add a `d1_databases` entry for an `env.DB` binding
  // (typed in src/env.d.ts), provisioned per app on first deploy —
  // "d1_databases": [{ "binding": "DB", "database_name": "app-db" }]
}
